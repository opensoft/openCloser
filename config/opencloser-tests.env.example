# Copy this file to the repo root as `.env.opencloser-tests`.
# Keep the copied file local only; `.env.*` is ignored by git.
#
# Usage from py-bench:
#   cd /workspace/projects/openCloser
#   source scripts/opencloser-tests-prep.sh
#
# Usage as a command wrapper:
#   scripts/opencloser-tests-prep.sh -- uv run opencloser run-crm ...
#
# Do not prefix values with `export`; the prep script exports them after loading.

DATAVERSE_ENV_URL=https://medx.crm.dynamics.com
DATAVERSE_TENANT_ID="<tenant-guid>"
DATAVERSE_CLIENT_ID="<app-registration-client-id>"
DATAVERSE_CLIENT_SECRET="<client-secret>"

# Dedicated Feature 002 tester record: OC-TEST-001 / OpenCloser Tester 001.
DATAVERSE_TEST_QUEUE_ITEM_GUID=7d8ef0d5-2e57-f111-bec6-000d3a5d4fc0
