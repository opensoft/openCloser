edit_file() {
  local path="$1"
  local missing_message="${2:-file does not exist yet}"

  if [[ ! -f "$path" ]]; then
    printf '%s: %s\n' "$missing_message" "$path"
    return 1
  fi

  local editor="${EDITOR:-}"
  if [[ -z "$editor" ]]; then
    for candidate in nano vim vi; do
      if command -v "$candidate" >/dev/null 2>&1; then
        editor="$candidate"
        break
      fi
    done
  fi

  if [[ -z "$editor" ]]; then
    printf 'No terminal editor found. Edit this file manually:\n%s\n' "$path"
    return 1
  fi

  "$editor" "$path"
}

edit_env_file() {
  edit_file "$env_file" "env file does not exist yet. Run option 1 first"
}

edit_slice2_config() {
  edit_file "$repo_root/config/slice2.toml" "Slice 2 config is missing"
}

review_mapping_artifact() {
  edit_file "$repo_root/config/dataverse_mapping.json" "CRM mapping is missing. Run CRM discovery first"
}

check_env() {
  "$repo_root/scripts/opencloser-tests-prep.sh" --check
}

discover_crm() {
  "$repo_root/scripts/opencloser-tests-prep.sh" -- uv run opencloser discover-crm
  printf '\nReview config/dataverse_mapping.json before approving it for write tests.\n'
}

run_dry_run_demo() {
  DATAVERSE_TEST_QUEUE_ITEM_GUID="$target_queue_item_guid" \
    "$repo_root/scripts/feature_002_demo.sh"
}

run_write_demo() {
  load_env_if_present
  section "Write-Enabled Feature 002 Demo"
  show_target_lead
  cat <<'EOF'

This path can mutate Dataverse. Before continuing, verify this lead in CRM and
capture the pre-demo state needed for rollback.
EOF

  local confirm_guid captured_guid
  printf '\nType the exact target GUID to confirm the dedicated test record: '
  read -r confirm_guid
  if [[ "$confirm_guid" != "$target_queue_item_guid" ]]; then
    printf 'confirmation did not match target GUID; stopping before write\n' >&2
    return 1
  fi

  printf 'Type the same GUID after confirming pre-demo CRM state is captured: '
  read -r captured_guid
  if [[ "$captured_guid" != "$target_queue_item_guid" ]]; then
    printf 'pre-demo state confirmation did not match target GUID; stopping before write\n' >&2
    return 1
  fi

  FEATURE_002_ENABLE_WRITE=1 \
    FEATURE_002_TEST_RECORD_CONFIRMED="$target_queue_item_guid" \
    FEATURE_002_PREDEMO_STATE_CAPTURED="$target_queue_item_guid" \
    DATAVERSE_TEST_QUEUE_ITEM_GUID="$target_queue_item_guid" \
    "$repo_root/scripts/feature_002_demo.sh"
}

print_next_steps() {
  cat <<EOF
Typical py-bench flow:

  cd /workspace/projects/openCloser
  ./setup-openCloser

Start with:
  1. Initialize local env file
  2. Select CRM and configure auth
  3. Check env
  4. Discover CRM metadata
  5. Review CRM mapping artifact
  6. Edit Slice 2 config
  7. Check full setup status
  8. Run dry-run demo
  9. Run write demo only after confirming the CRM lead

The local secret file is:
  $env_file

The write target is:
  $target_queue_item_guid
EOF
}

menu() {
  while true; do
    load_env_if_present
    clear 2>/dev/null || true
    cat <<EOF
openCloser setup
Repo: $repo_root
Env:  $env_file

$(show_target_lead)

Choose an option:
  1) Initialize local test env file
  2) Select CRM and configure auth
  3) Edit local test env file
  4) Check Dataverse env values
  5) Discover CRM metadata
  6) Review CRM mapping artifact
  7) Edit Slice 2 config
  8) Show full setup status
  9) Run Feature 002 dry-run demo
  10) Run Feature 002 write-enabled demo
  n) Show next steps
  q) Quit
EOF

    printf '\nSelection: '
    read -r choice || return 0

    case "$choice" in
      1) run_step "Initialize Local Env File" init_env_file; pause ;;
      2) run_step "Select CRM and Configure Auth" select_crm_and_configure_auth || true; pause ;;
      3) run_step "Edit Local Env File" edit_env_file || true; pause ;;
      4) run_step "Check Dataverse Env Values" check_env || true; pause ;;
      5) run_step "Discover CRM Metadata" discover_crm || true; pause ;;
      6) run_step "Review CRM Mapping Artifact" review_mapping_artifact || true; pause ;;
      7) run_step "Edit Slice 2 Config" edit_slice2_config || true; pause ;;
      8) show_status; pause ;;
      9) run_step "Feature 002 Dry-Run Demo" run_dry_run_demo || true; pause ;;
      10) run_write_demo || true; pause ;;
      n|N) print_next_steps; pause ;;
      q|Q|quit|exit) return 0 ;;
      *) printf 'Unknown selection: %s\n' "$choice"; pause ;;
    esac
  done
}

case "${1:-}" in
  -h|--help)
    usage
    ;;
  --status)
    show_status
    ;;
  "")
    if [[ ! -t 0 ]]; then
      usage >&2
      exit 2
    fi
    menu
    ;;
  *)
    printf 'error: unknown argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
