}

show_slice2_status() {
  local config="$repo_root/config/slice2.toml"
  if [[ ! -f "$config" ]]; then
    printf 'slice2 config: missing (%s)\n' "$config"
    return 0
  fi

  local py
  py="$(python_bin)" || {
    printf 'slice2 config: present, details unknown because python is unavailable\n'
    return 0
  }

  "$py" - "$config" <<'PY' || true
import re
import sys
import tomllib
from pathlib import Path

path = Path(sys.argv[1])
try:
    config = tomllib.loads(path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"slice2 config: unreadable TOML ({exc})")
    raise SystemExit(0)

run = config.get("run", {})
dataverse = config.get("dataverse", {})
owners = config.get("task_owners", {})
redaction = config.get("redaction", {})
guid_re = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")

campaign = str(run.get("campaign", "")).strip()
callable_status = str(dataverse.get("callable_status", "")).strip()
callback = str(owners.get("callback", "")).strip()
review = str(owners.get("review", "")).strip()
callback_ok = bool(guid_re.fullmatch(callback))
review_ok = bool(guid_re.fullmatch(review))
policy = str(redaction.get("policy", "")).strip()
retention = str(redaction.get("retention", "")).strip()

print(f"slice2 campaign: {'present' if campaign else 'missing'}{f' ({campaign})' if campaign else ''}")
print(f"slice2 callable_status: {'present' if callable_status else 'missing'}{f' ({callable_status})' if callable_status else ''}")
print(f"slice2 task owner callback: {'present' if callback_ok else 'missing/placeholder'}")
print(f"slice2 task owner review: {'present' if review_ok else 'missing/placeholder'}")
print(f"slice2 redaction: policy={policy or 'missing'}, retention={retention or 'missing'}")
PY
}

