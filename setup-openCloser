show_mapping_status() {
  local mapping="$repo_root/config/dataverse_mapping.json"
  if [[ ! -f "$mapping" ]]; then
    printf 'mapping: missing (%s)\n' "$mapping"
    return 0
  fi

  local py
  py="$(python_bin)" || {
    printf 'mapping: present, approval unknown because python is unavailable\n'
    return 0
  }

  "$py" - "$mapping" <<'PY' || true
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception as exc:
    print(f"mapping: present, unreadable JSON ({exc})")
    raise SystemExit(0)

approved = data.get("_meta", {}).get("approved") is True
has_environment = bool(data.get("_meta", {}).get("environment_url") or data.get("_meta", {}).get("dataverse_env_url"))
print(f"mapping: present, approved={str(approved).lower()}, environment_recorded={str(has_environment).lower()}")
